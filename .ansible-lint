---
# Ansible-lint configuration

# Exclude paths
exclude_paths:
  # Generated and cache directories
  - .github/
  - .ansible/
  - .venv/
  - venv/
  - .molecule/
  - .cache/
  - tests/vcsim/
  - sim_shared_dir/
  - state/
  - v1_backup_*/
  # Old v1 playbook files (not part of v2 rewrite)
  - addhosts_vcenter.yml
  - cronjob.yml
  - create_datastore.yml
  - dvs_hosts_vcenter.yml
  - esxinested.yml
  - getcerts.yml
  - host_groups.yml
  - main.yml
  - nfshostip.yml
  - packlocal.yml
  - platform.example.yaml
  - tagging.yml
  - vcnested.yml
  - vsphere_remove.yml

# Enable checking of loop variable prefixes in roles
loop_var_prefix: "{role}_"

# Enforce variable naming patterns
var_naming_pattern: "^[a-z_][a-z0-9_]*$"

# Use default rules set
profile: production

# Skip specific rules (with justification)
skip_list:
  # Allow using command instead of module when necessary
  # - command-instead-of-module

  # Allow using shell when necessary for complex commands
  # - command-instead-of-shell

  # Temporary: Skip no-changed-when during development
  # Remove this before production release
  - no-changed-when

  # Temporary: Skip name rules during rewrite
  # These enforce style/formatting that can be addressed in a follow-up PR
  - name[casing]
  - name[template]
  - key-order

# Enable specific rules
enable_list:
  - args
  - empty-string-compare
  - no-log-password
  - no-same-owner
  - yaml

# Warn instead of error for these rules
warn_list:
  - experimental
  - ignore-errors
  - no-handler
  - fqcn-builtins

# Set ansible and collections versions for linting
# This helps catch deprecations and compatibility issues
offline: false

# Use YAML-specific settings
kinds:
  - yaml: "*.yaml"
  - yaml: "*.yml"
  - playbook: "**/playbooks/*.yml"
  - playbook: "**/playbooks/*.yaml"
  - tasks: "**/tasks/*.yml"
  - tasks: "**/tasks/*.yaml"
  - handlers: "**/handlers/*.yml"
  - vars: "**/vars/*.yml"
  - vars: "**/group_vars/*.yml"
  - vars: "**/host_vars/*.yml"
  - defaults: "**/defaults/*.yml"
  - meta: "**/meta/*.yml"

# Mock modules and roles for linting
mock_modules:
  - community.vmware.vmware_guest
  - community.vmware.vmware_datacenter
  - community.vmware.vmware_cluster
  - vmware.vmware.deploy_content_library_ovf

mock_roles:
  - vsphere_vm_deploy
  - vsphere_datacenter_config
  - vsphere_host_config
  - vsphere_networking
  - vsphere_storage
  - vsphere_tagging
  - vsphere_host_groups
